# Morse Code Decoder Configuration
# Generated: 2025-09-19 21:55:00
#
# This file uses clear parameter names with unit suffixes for safety.
# All defaults are optimized for real-world morse code audio.
#
# Unit naming conventions:
#   *_hz = frequency units
#   *_norm = normalized values [0.0-1.0]
#   *_ms, *_sec = time units
#

application:
  debug: false              # Enable debug mode and verbose logging | BOOL | default: false
  log_level: "INFO"         # Global log level | ENUM | {DEBUG, INFO, WARNING, ERROR, CRITICAL} | default: INFO
  output_file: null         # Output file path for decoded text | STR|NULL | (null to disable)
  realtime: false           # Process audio in real-time for live debugging | BOOL | default: false
  playback_speed: 1.0       # Playback speed multiplier (0.5=half, 2.0=double) | FLOAT | default: 1.0

  # Per-component log level overrides for debugging
  logging:
    # Uncomment to debug specific components:
    # morsecode.components.audio.hal: "DEBUG"
    # morsecode.components.signal.signal_processor: "DEBUG"
    # morsecode.components.decoder.morse_decoder: "DEBUG"

graphics:
  enabled: true             # Enable real-time graphics display | BOOL | default: true
  backend: "ascii"          # Graphics backend for debug display | ENUM | {auto, ascii, braille, plotly} | default: ascii
                            #   ascii: Universal compatibility, works over SSH, lower resolution
                            #   braille: 2x higher resolution, modern terminals only
                            #   plotly: Rich interactive web-based graphs in browser (requires: pip install plotly)
                            #   auto: Automatic detection based on terminal capabilities
  display_width_chars: 0   # Display width: 0=auto terminal detection, or fixed width 40-200 | default: 0
  display_height_chars: 20  # Display height in characters | INT | 10-50 | default: 20
  refresh_rate_fps: 20      # Display refresh rate | INT | 1-60 fps | default: 20
  buffer_size_sec: 5.0      # Time-series buffer size | DOUBLE | 0.5-20.0 | default: 5.0
  enable_debug_logging: false # Enable debug logging for display | BOOL | default: false
  chunk_size_ms: 20         # Processing chunk size (should match decoder_app.py actual processing) | INT | 10-100 | default: 20
  convolution_interval_ms: 20 # Convolution processing interval for probability data (20ms = 50Hz sync with FFT/magnitude) | INT | 10-2000 | default: 20
  playback_speed: 1.0       # Playback speed multiplier for time synchronization | DOUBLE | default: 1.0

signal:
  # Core signal detection parameters (with clear unit naming)
  frequency_hz: 600         # Target CW frequency for tone detection | INT | 200-2000 Hz | default: 600
  signal_threshold_norm: 0.25  # Signal detection threshold: minimum energy level to detect CW tone presence | DOUBLE | 0.0-1.0 | default: 0.25 (optimized for real-world)
  bandwidth_hz: 50          # Filter bandwidth around target frequency | INT | 10-500 Hz | default: 50
  sample_rate_hz: 44100     # Audio sample rate | INT | 8000-96000 Hz | default: 44100
  mode: "AUTO"              # Signal processing mode | ENUM | {AUTO, MANUAL, ADAPTIVE} | default: AUTO
  adaptive_frequency: true  # Enable adaptive frequency detection (auto-finds strongest frequency peak) | BOOL | default: true

  # Profile overrides for different use cases
  # Debug profile (--profile debug) - for synthetic test patterns
  signal_threshold_norm_debug: 0.3     # Higher threshold for clean test signals
  adaptive_frequency_debug: false      # Disable adaptive frequency for exact --frequency control

decoder:
  # Core timing parameters (with clear naming)
  wpm: 20                   # Words per minute estimate (PARIS standard) | INT | 5-60 WPM | default: 20
  timing_tolerance_norm: 0.7   # Timing tolerance: how forgiving when discriminating dots vs dashes vs spaces | DOUBLE | 0.0-1.0 | default: 0.7 (optimized for real-world)
  dot_duration_ms: null     # Dot duration in milliseconds | DOUBLE|NULL | (null = auto-calculate from WPM)

  # Profile overrides
  # Debug profile (--profile debug) - for synthetic test patterns
  timing_tolerance_norm_debug: 0.3    # Strict timing for clean test signals
  wpm_debug: 15                        # Standard test WPM

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Standard usage (real-world audio, optimized by default):
#   morsecode audio.wav -s decoder-wpm=20                # Adjust WPM to match actual speed
#   morsecode audio.wav -s decoder-wpm=13                # For slower operators
#   morsecode audio.wav -s decoder-wpm=25                # For faster operators

# For synthetic test patterns (need stricter timing):
#   morsecode pattern.wav --cfg-profile debug            # Uses stricter timing (0.3) for clean signals

# Manual parameter overrides:
#   morsecode audio.wav -s decoder-timing-tolerance-norm=0.8    # Extra forgiving timing
#   morsecode audio.wav -s signal-signal-threshold-norm=0.2     # Lower detection threshold
#   morsecode audio.wav -s signal-frequency-hz=800             # Different target frequency

# Multiple overrides (comma-separated for convenience):
#   morsecode audio.wav -s "decoder-wpm=20,signal-frequency-hz=800,application-debug=true"

# Graphics and debugging:
#   morsecode audio.wav -s application-debug=true -s application-log-level=DEBUG   # Verbose logging
#   morsecode audio.wav -s graphics-backend=plotly             # Interactive web graphs
#   morsecode audio.wav -s graphics-enabled=true               # Enable real-time visualization
#   morsecode --cfg-show                                        # Show current config with comments
