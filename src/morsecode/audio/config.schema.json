{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audio Module Configuration",
  "description": "Audio processing and hardware abstraction layer configuration",
  "type": "object",
  "properties": {
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 96000,
      "default": 44100,
      "description": "Audio sample rate in Hz"
    },
    "wav_filename": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Path to WAV audio file"
    },
    "auto_gain_control": {
      "type": "boolean",
      "default": true,
      "description": "Enable automatic gain control"
    },
    "chunk_size_ms": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000,
      "default": 50,
      "description": "Audio chunk size in milliseconds"
    }
  },
  "additionalProperties": false
}