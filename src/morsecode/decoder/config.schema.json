{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decoder Module Configuration",
  "description": "Morse code pattern recognition and decoding configuration",
  "type": "object",
  "properties": {
    "wpm": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60,
      "default": 15,
      "description": "Initial WPM estimate for timing analysis"
    },
    "tolerance": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.3,
      "description": "Timing tolerance for pattern recognition"
    },
    "dot_duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 10,
      "maximum": 1000,
      "default": null,
      "description": "Override dot duration in milliseconds"
    },
    "min_silence_ms": {
      "type": "number",
      "minimum": 50,
      "maximum": 2000,
      "default": 200,
      "description": "Minimum silence for word separation"
    }
  },
  "additionalProperties": false
}