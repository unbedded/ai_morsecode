{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Module Configuration",
  "description": "Signal processing and tone detection configuration",
  "type": "object",
  "properties": {
    "frequency": {
      "type": "integer",
      "minimum": 200,
      "maximum": 2000,
      "default": 600,
      "description": "Target CW frequency in Hz for tone detection"
    },
    "threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.3,
      "description": "Tone detection threshold (0.0-1.0)"
    },
    "bandwidth": {
      "type": "integer",
      "minimum": 10,
      "maximum": 500,
      "default": 50,
      "description": "Filter bandwidth in Hz"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 96000,
      "default": 44100,
      "description": "Audio sample rate in Hz"
    }
  },
  "additionalProperties": false
}